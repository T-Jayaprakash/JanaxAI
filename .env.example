# All values are optional. Copy to .env.local to override.

# Where the SQLite database, uploads, renders and thumbnails are stored.
# JANUX_DATA_DIR=./data

# Production database (AWS RDS PostgreSQL). Unset = local SQLite file in JANUX_DATA_DIR.
# DATABASE_URL=postgres://user:password@host:5432/janux?sslmode=require
# DATABASE_POOL_SIZE=10
# Tests can run on embedded Postgres: DATABASE_URL=pglite://memory npm test

# Accounts and workspaces (Better Auth). Always on in production; off by default locally.
# JANUX_AUTH=on
# BETTER_AUTH_SECRET=   # 32+ random characters: openssl rand -base64 32
# BETTER_AUTH_URL=https://app.januxai.com
# Login codes and invitations are emailed through AWS SES (verified sender; IAM role or AWS keys).
# SES_FROM_EMAIL=JANUXAI <login@januxai.com>
# SES_REGION=ap-south-1
# Optional "Continue with Google" (OAuth client from Google Cloud Console).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# FFmpeg binaries (defaults use your PATH).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Upload and render limits.
# JANUX_MAX_UPLOAD_MB=300
# JANUX_MAX_FILES_PER_MESSAGE=50
# JANUX_MAX_CLIP_SECONDS=900
# JANUX_MAX_OUTPUT_SECONDS=180
# JANUX_OUTPUT_LONG_EDGE=1280
# JANUX_IMAGE_STILL_SECONDS=3

# Safety rails.
# JANUX_MIN_FREE_DISK_MB=1024
# JANUX_FFMPEG_TIMEOUT_SEC=600
# JANUX_MAX_JOB_ATTEMPTS=3

# Never put provider API keys in NEXT_PUBLIC_* variables; they'd be shipped to the browser.

# AI engine: auto | api | claude-cli | rules (see docs/AI_PROVIDERS.md).
# JANUX_AI=auto
# Production: server-side Claude API key (billed per token, separate from Claude Pro/Max).
# ANTHROPIC_API_KEY=
# JANUX_MODEL=claude-opus-5-5
# JANUX_WEB_SEARCH=off
# Local testing with your own Claude Code login:
# CLAUDE_CLI_PATH=~/.local/bin/claude
# JANUX_CLI_MODEL=opus

# Design / motion rendering
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Voice notes (local whisper.cpp)
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=./data/models/ggml-small.bin

# Voiceover: premium providers (server-side keys only). auto picks the best configured one.
# JANUX_VOICE=auto            # auto | elevenlabs | google | system
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4  # Tamil, Telugu, Malayalam, Kannada, Bengali, Hindi, English
# ELEVENLABS_VOICE_ID=        # default voice; the editor can pick others with list_voices
# GOOGLE_TTS_API_KEY=         # Google Cloud Text-to-Speech, Chirp 3 HD voices
