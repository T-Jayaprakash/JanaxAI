{
  "name": "januxai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c green,cyan \"next dev -H 127.0.0.1 -p 3000\" \"tsx watch worker/index.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start -H 127.0.0.1 -p 3000\" \"NODE_ENV=production tsx worker/index.ts\"",
    "lint": "eslint",
    "web": "next dev -H 127.0.0.1 -p 3000",
    "worker": "tsx worker/index.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:speech": "bash scripts/setup-speech.sh",
    "setup:tracking": "tsx scripts/setup-tracking.ts",
    "setup:library": "tsx scripts/setup-library.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
